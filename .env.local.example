# Настройки локальной инфраструктуры (compose.local.yml).
# Скопируйте в .env.local и подставьте свои значения:
#
#   cp .env.local.example .env.local
#   docker compose --env-file .env.local -f compose.local.yml up -d
#
# Не путайте с .env: тот файл описывает dev-стенд (compose.yml) и живёт
# только на сервере.

# PostgreSQL приложения
POSTGRES_DB=sova
POSTGRES_USER=sova
POSTGRES_PASSWORD=
POSTGRES_HOST_PORT=5432

# Redis
REDIS_HOST_PORT=6379
# Значения, которые задаются отдельно в sova-backend/.env для локального Daphne.
CHANNEL_REDIS_URL=redis://localhost:6379/2
REALTIME_MAX_CONNECTION_AGE_SECONDS=1800
REALTIME_CHANNEL_CAPACITY=100

# Gotenberg (публикуется только на 127.0.0.1)
GOTENBERG_HOST_PORT=3001

# Keycloak
KEYCLOAK_HOST_PORT=8080
KEYCLOAK_REALM=sova
KEYCLOAK_CLIENT_ID=sova-web
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_EMAIL_FROM=noreply@localhost

# Порт локального Next.js. Используется для rootUrl и redirect URI клиента
# sova-web в импортируемом realm.
FRONTEND_HOST_PORT=3000

# Исходящая почта. Оставьте пустым — Keycloak не сможет отправлять письма,
# а Django выведет их в консоль. Первого тестового пользователя в этом случае
# создайте в Admin Console с включённым Email verified.
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false

# Своё S3-совместимое хранилище файлов (сервис s3, опционально — см. sova-backend/README.md).
# Нужно только если в sova-backend/.env вы выставили STORAGE_BACKEND=s3.
S3_HOST_PORT=3900
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
