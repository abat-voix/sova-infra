# Runtime environment
ENVIRONMENT=development
DOMAIN=dev.sova.1uup.ru
AUTH_DOMAIN=auth.dev.sova.1uup.ru
APP_PUBLIC_URL=https://dev.sova.1uup.ru

# Immutable application image tags are recommended after the initial dev setup.
FRONTEND_TAG=dev
BACKEND_TAG=dev

# PostgreSQL
POSTGRES_DB=sova
POSTGRES_USER=sova
POSTGRES_PASSWORD=
DATABASE_URL=

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CHANNEL_REDIS_URL=redis://redis:6379/2
REALTIME_MAX_CONNECTION_AGE_SECONDS=1800
REALTIME_CHANNEL_CAPACITY=100

# Background report exports (files are kept in a private Docker volume)
REPORTS_WORKER_CONCURRENCY=2
REPORTS_RETENTION_HOURS=72
REPORTS_JOB_TIMEOUT_SECONDS=1800
REPORTS_MAX_ATTEMPTS=3
REPORTS_PDF_MAX_ROWS=5000
REPORTS_XLS_MAX_SHEETS=4
REPORTS_MAX_ACTIVE_JOBS_PER_USER=5

# PDF generation (internal service; do not expose it through Caddy)
GOTENBERG_URL=http://gotenberg:3000
GOTENBERG_TIMEOUT=30

# File storage — see sova-backend/docs/plans/2026-09-23-s3-storage.md.
# S3_PROVIDER=garage adds compose.s3.yml (own Garage service) to deploy.sh's compose files;
# S3_PROVIDER=external assumes the S3_* values below already point at your own provider
# (Yandex Object Storage, AWS, etc.) and skips the Garage service entirely.
S3_PROVIDER=garage
# filesystem keeps the current behaviour (django_media/reports_data volumes below); s3 moves
# every upload (attachments, contract files, reports) to the configured S3-compatible bucket.
STORAGE_BACKEND=filesystem
# proxy: Django streams the file itself (storage stays internal-only).
# redirect: 302 to a signed URL — only meaningful when S3_ENDPOINT_URL is reachable by browsers.
S3_DOWNLOAD_MODE=proxy
S3_ENDPOINT_URL=http://s3:3900
S3_REGION=garage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_MEDIA_BUCKET=sova-media
S3_REPORTS_BUCKET=sova-reports
# Garage-only: cluster RPC secret and admin API token (never used by an external provider).
# Generate with: openssl rand -hex 32 (RPC secret) / openssl rand -base64 32 (admin token).
# S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY for Garage are created by scripts/s3-bootstrap.sh from
# these same values — set them here first, then run the bootstrap script.
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
GARAGE_CAPACITY=20G
# How long backup.sh keeps objects it moved into backups/s3/deleted/ (they replace what
# object versioning would have kept — Garage has none). The reports bucket is not backed up.
S3_BACKUP_DELETED_RETENTION_DAYS=90

# Keycloak
KEYCLOAK_PUBLIC_URL=https://auth.dev.sova.1uup.ru
KEYCLOAK_REALM=sova
KEYCLOAK_CLIENT_ID=sova-web
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_EMAIL_FROM=noreply@1uup.ru
OIDC_REDIRECT_URI=https://dev.sova.1uup.ru/api/auth/oidc/callback/
SESSION_COOKIE_AGE=28800

# Optional Keycloak test accounts for the dev environment only.
# When enabled, every deploy reconciles these users and resets their passwords
# to the values below. Do not reuse these passwords anywhere else.
SEED_TEST_ACCOUNTS=false
TEST_KAM_PASSWORD=
TEST_BOSS_PASSWORD=
TEST_ADMIN_PASSWORD=

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=dev.sova.1uup.ru
CSRF_TRUSTED_ORIGINS=https://dev.sova.1uup.ru
STATIC_ROOT=/app/staticfiles
MEDIA_ROOT=/app/media

# Outgoing email (RU-CENTER SMTP over SSL)
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL="СОВА <noreply@1uup.ru>"

# Outgoing Telegram notifications. Keep the BotFather token secret; per-user
# chat IDs are configured in notification profiles in the application.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Необязательный отдельный HTTP(S) или SOCKS proxy URL для Telegram.
TELEGRAM_PROXY=
NOTIFICATION_HTTP_TIMEOUT=10

# Optional: only set these in the shell for private GHCR images.
# Do not store a GHCR token in .env.
# GHCR_USERNAME=
# GHCR_TOKEN=
