# Runtime environment
ENVIRONMENT=development
DOMAIN=dev.sova.1uup.ru
AUTH_DOMAIN=auth.dev.sova.1uup.ru
APP_PUBLIC_URL=https://dev.sova.1uup.ru

# Immutable application image tags are recommended after the initial dev setup.
FRONTEND_TAG=dev
BACKEND_TAG=dev

# PostgreSQL
POSTGRES_DB=sova
POSTGRES_USER=sova
POSTGRES_PASSWORD=
DATABASE_URL=

# Redis
REDIS_URL=redis://redis:6379/0

# Keycloak
KEYCLOAK_PUBLIC_URL=https://auth.dev.sova.1uup.ru
KEYCLOAK_REALM=sova
KEYCLOAK_CLIENT_ID=sova-web
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_EMAIL_FROM=noreply@1uup.ru
OIDC_REDIRECT_URI=https://dev.sova.1uup.ru/api/auth/oidc/callback/
SESSION_COOKIE_AGE=28800

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=dev.sova.1uup.ru
CSRF_TRUSTED_ORIGINS=https://dev.sova.1uup.ru
STATIC_ROOT=/app/staticfiles
MEDIA_ROOT=/app/media

# Outgoing email (RU-CENTER SMTP over SSL)
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL="СОВА <noreply@1uup.ru>"

# Optional: only set these in the shell for private GHCR images.
# Do not store a GHCR token in .env.
# GHCR_USERNAME=
# GHCR_TOKEN=
