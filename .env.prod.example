# Copy to /srv/docker/sova.1uup.ru/.env.prod on the production server.
# Keep this file private there. Quote values containing spaces, #, $ or shell metacharacters.
ENVIRONMENT=production
DOMAIN=sova.1uup.ru
AUTH_DOMAIN=auth.sova.1uup.ru
APP_PUBLIC_URL=https://sova.1uup.ru
KEYCLOAK_PUBLIC_URL=https://auth.sova.1uup.ru
OIDC_REDIRECT_URI=https://sova.1uup.ru/api/auth/oidc/callback/
DJANGO_ALLOWED_HOSTS=sova.1uup.ru
CSRF_TRUSTED_ORIGINS=https://sova.1uup.ru
DJANGO_DEBUG=false
SEED_TEST_ACCOUNTS=false

POSTGRES_DB=sova
POSTGRES_USER=sova
POSTGRES_PASSWORD=
# URL-encode special characters in the password here.
DATABASE_URL=
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CHANNEL_REDIS_URL=redis://redis:6379/2
GOTENBERG_URL=http://gotenberg:3000

DJANGO_SECRET_KEY=
KEYCLOAK_REALM=sova
KEYCLOAK_CLIENT_ID=sova-web
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=

EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL="СОВА <noreply@1uup.ru>"
KEYCLOAK_EMAIL_FROM=noreply@1uup.ru

# Filesystem storage needs a separate backup of the django_media volume.
# For S3, set STORAGE_BACKEND=s3 and S3_PROVIDER=garage or external, then add S3 credentials.
STORAGE_BACKEND=filesystem
S3_PROVIDER=external
